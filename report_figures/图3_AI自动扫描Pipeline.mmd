stateDiagram-v2
    [*] --> 巡线中
    巡线中 --> Phase0_冷却等待 : 自动触发

    state Phase0_冷却等待 {
        [*] --> 初始稳定5s
        初始稳定5s --> 间隔15s
        间隔15s --> 冷却到期
    }

    Phase0_冷却等待 --> Phase1_AI扫描 : 冷却到期

    state Phase1_AI扫描 {
        [*] --> 停车制动
        停车制动 --> 腰座扫描±60
        腰座扫描±60 --> AI分类检测
        AI分类检测 --> 超时8s : 未检测到
        AI分类检测 --> 检测到目标 : class_id=0 conf≥50%
        超时8s --> 恢复巡线
    }

    Phase1_AI扫描 --> Phase2_对准 : 检测到目标
    Phase1_AI扫描 --> Phase0_冷却等待 : 超时/恢复巡线

    state Phase2_对准 {
        [*] --> 子阶段0_腰座比例转向
        子阶段0_腰座比例转向 --> 子阶段1_车身前后微调 : cx误差≤25px
        子阶段1_车身前后微调 --> 对齐完成 : cx≤15px dist≤8cm
        子阶段1_车身前后微调 --> 强制执行 : 10s超时
    }

    Phase2_对准 --> Phase3_抓取 : 对齐完成/超时

    state Phase3_抓取 {
        [*] --> 保存腰座角度
        保存腰座角度 --> Action_Grasp
        Action_Grasp --> 还原腰座角度
        还原腰座角度 --> 切回QRCODE模式
        切回QRCODE模式 --> 恢复巡线
    }

    Phase3_抓取 --> Phase0_冷却等待 : 15s冷却
