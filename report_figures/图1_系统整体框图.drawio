        <mxCell id="exec_motor" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontFamily=Microsoft YaHei;fontSize=12;align=center;verticalAlign=middle;fillColor=#F2D7D5;strokeColor=#C0392B;strokeWidth=2;fontColor=#641E16;fontStyle=1;" value="&lt;b&gt;4路直流电机驱动&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;左前 · 右前 · 左后 · 右后  四轮差速&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;四轮独立PID闭环调速  |  PWM 1kHz&lt;/font&gt;" vertex="1">
          <mxGeometry height="150" width="340" x="50" y="80" as="geometry" />
        </mxCell>
        <mxCell id="exec_servo" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontFamily=Microsoft YaHei;fontSize=12;align=center;verticalAlign=middle;fillColor=#FCF3CF;strokeColor=#D4AC0D;strokeWidth=2;fontColor=#7D6608;fontStyle=1;" value="&lt;b&gt;3路舵机 (4-DOF机械臂)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;腰座 · 大臂 · 小臂  三关节联动&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;50Hz PWM  |  平滑插值运动&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;智能断电管理: 大臂常开 / 腰座小臂节能关断&lt;/font&gt;" vertex="1">
          <mxGeometry height="150" width="360" x="430" y="80" as="geometry" />
        </mxCell>
        <mxCell id="exec_comm" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontFamily=Microsoft YaHei;fontSize=12;align=center;verticalAlign=middle;fillColor=#D1F2EB;strokeColor=#117A65;strokeWidth=2;fontColor=#0B5345;fontStyle=1;" value="&lt;b&gt;通信与调试接口&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;调试串口 115200bps  |  OpenMV视觉通信&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;PC端 AI自动调参工具 (LLM PID Tuner)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;SWD在线调试  |  USB-TTL串口命令&lt;/font&gt;" vertex="1">
