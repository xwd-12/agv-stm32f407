        </mxCell>
        <mxCell id="dec_ctrl" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontFamily=Microsoft YaHei;fontSize=12;align=center;verticalAlign=middle;fillColor=#D5F5E3;strokeColor=#1E8449;strokeWidth=2;fontColor=#145A32;fontStyle=1;" value="&lt;b&gt;控制环路&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;巡线 PID — 自动沿黑线循迹 (100Hz)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;速度 PID — 四轮独立闭环调速 (100Hz)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;位置 PID — 编码器里程定点移动 (50Hz)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;视觉伺服 PID — 视觉标签自动对接 (100Hz)&lt;/font&gt;" vertex="1">
          <mxGeometry height="150" width="340" x="50" y="330" as="geometry" />
