        <mxCell id="dec_sm" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fontFamily=Microsoft YaHei;fontSize=12;align=center;verticalAlign=middle;fillColor=#D5F5E3;strokeColor=#1E8449;strokeWidth=2;fontColor=#145A32;fontStyle=1;" value="&lt;b&gt;任务调度 (6状态机)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;机械臂互斥锁 — 防冲突 + 30s超时保护&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;AI自动扫描 — 巡线中自动触发抓取&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;多步骤任务队列 — 脚本化编排 (≤16步)&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;视觉任务 — 颜色/二维码/AI 分类识别&lt;/font&gt;" vertex="1">
